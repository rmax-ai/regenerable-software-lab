{
  "name": "regenerable-software-lab",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "Experimental benchmark for evaluating whether AI coding agents can repeatedly generate software from durable, implementation-independent verification bundles",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm -r --if-present run test",
    "test:watch": "pnpm -r --if-present --parallel run test:watch",
    "test:hidden": "pnpm --dir benchmarks/order-pricing/hidden --ignore-workspace test",
    "test:property": "pnpm --dir benchmarks/order-pricing/hidden --ignore-workspace test:property"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
